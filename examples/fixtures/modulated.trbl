{
  "format_version": 1,
  "instrument": {
    "name": "Modulated rack sine",
    "description": "A note-triggered sine with same-sample linear FM, AM and cutoff CV.",
    "patch": {
      "modules": [
        {
          "id": "osc",
          "type_id": "treble.oscillator",
          "type_version": 1,
          "parameters": {}
        },
        {
          "id": "filter",
          "type_id": "treble.low_pass",
          "type_version": 1,
          "parameters": {}
        },
        {
          "id": "output",
          "type_id": "treble.output",
          "type_version": 1,
          "parameters": {}
        },
        {
          "id": "lfo",
          "type_id": "treble.lfo",
          "type_version": 1,
          "parameters": {
            "frequency": {
              "kind": "float",
              "value": 5.0
            },
            "amplitude": {
              "kind": "float",
              "value": 0.5
            }
          }
        }
      ],
      "cables": [
        {
          "id": "osc_filter",
          "from": {
            "module": "osc",
            "port": "out"
          },
          "to": {
            "module": "filter",
            "port": "in"
          },
          "modulation": null
        },
        {
          "id": "filter_output",
          "from": {
            "module": "filter",
            "port": "out"
          },
          "to": {
            "module": "output",
            "port": "in"
          },
          "modulation": null
        },
        {
          "id": "linear_fm",
          "from": {
            "module": "lfo",
            "port": "out"
          },
          "to": {
            "module": "osc",
            "port": "frequency_cv"
          },
          "modulation": {
            "mode": "add",
            "depth": 40.0
          }
        },
        {
          "id": "tremolo",
          "from": {
            "module": "lfo",
            "port": "out"
          },
          "to": {
            "module": "osc",
            "port": "amplitude_cv"
          },
          "modulation": {
            "mode": "multiply",
            "depth": 0.5
          }
        },
        {
          "id": "cutoff_motion",
          "from": {
            "module": "lfo",
            "port": "out"
          },
          "to": {
            "module": "filter",
            "port": "cutoff_cv"
          },
          "modulation": {
            "mode": "add",
            "depth": 1.0
          }
        }
      ]
    },
    "interface": {
      "note_input": {
        "module": "osc",
        "port": "trigger"
      },
      "audio_outputs": [
        {
          "module": "output",
          "port": "out"
        }
      ],
      "controls": []
    },
    "voice": {
      "kind": "monophonic"
    }
  },
  "editor": {
    "rack": {
      "osc": [
        0,
        0
      ],
      "filter": [
        0,
        1
      ],
      "output": [
        0,
        2
      ],
      "lfo": [
        0,
        3
      ]
    }
  }
}
